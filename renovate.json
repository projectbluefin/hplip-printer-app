{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "baseBranchPatterns": ["main"],
  "enabledManagers": ["custom.regex", "github-actions", "pip_requirements"],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements\\/printer-app\\/hplip\\.bst$/"],
      "matchStrings": ["(?<currentValue>debian/\\d+\\.\\d+\\.\\d+\\+dfsg0-\\d+)\\n    ref: debian/[^\\s]+-0-g(?<currentDigest>[a-f0-9]{40})"],
      "depNameTemplate": "printing-team/hplip.v2",
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://salsa.debian.org",
      "versioningTemplate": "regex:^debian/(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+dfsg0-(?<build>\\d+)$",
      "autoReplaceStringTemplate": "{{{newValue}}}\n    ref: {{{newValue}}}-0-g{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:-\\d+)?\\n"],
      "depNameTemplate": "printing-team/hplip.v2",
      "datasourceTemplate": "gitlab-tags",
      "registryUrlTemplate": "https://salsa.debian.org",
      "extractVersionTemplate": "^debian/(?<version>\\d+\\.\\d+\\.\\d+)\\+dfsg0-\\d+$",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{newValue}}}\n"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements\\/printer-app\\/net-snmp\\.bst$/"],
      "matchStrings": ["(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\n    ref: (?<currentDigest>[a-f0-9]{40})"],
      "depNameTemplate": "net-snmp/net-snmp",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "{{{newValue}}}\n    ref: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^elements\\/fsdk-containers\\.bst$/"],
      "matchStrings": ["track: (?<currentValue>main)\\n    ref: (?:\\S+-g)?(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "https://github.com/projectbluefin/fsdk-containers",
      "datasourceTemplate": "git-refs",
      "autoReplaceStringTemplate": "track: {{{newValue}}}\n    ref: {{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["printing-team/hplip.v2"],
      "groupName": "HPLIP driver source and application version"
    },
    {
      "description": "fsdk-containers junction: a bare ref bump is complete; GitHub auto-merge enqueues it in the merge queue after required checks, and main auto-publishes. git-refs digests carry no release timestamp, so no minimumReleaseAge.",
      "matchDepNames": ["https://github.com/projectbluefin/fsdk-containers"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": false,
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    },
    {
      "description": "Third-party GitHub Actions updates wait three days after release, then Renovate automerges them. The hive also merges Renovate PRs once the required checks pass, because mergeraptor is a trusted bot.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["!projectbluefin/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions-third-party-non-major",
      "pinDigests": true,
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "First-party projectbluefin/** actions merge right away and open at any time.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["projectbluefin/**"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github-actions-first-party-non-major",
      "pinDigests": true,
      "schedule": ["at any time"],
      "automerge": true
    },
    {
      "description": "BuildStream builds fail on ubuntu-26.04 runners (fsdk-containers#332); keep 24.04",
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "/^24\\.04(?:-arm)?$/"
    },
    {
      "description": "registry-actions.yml is a human-merge path in the hive. Give its updates their own branches, so a pin-only update to it is a PR of its own that the hive's pin-only exception can merge, instead of being held with other workflows.",
      "matchFileNames": [".github/workflows/registry-actions.yml"],
      "additionalBranchPrefix": "publishing-workflows-"
    },
    {
      "description": "Renovate never automerges GitHub Actions majors. The hive's trusted-bot merge policy is independent of this setting.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
